    @@check(expression: "(status = 'direservasi' AND dilepas_pada IS NULL) OR (status IN ('dibatalkan', 'dilepas') AND dilepas_pada IS NOT NULL)", name: "stock_reservation_status_matches_release_time")
    @@index([id_sumber_pemenuhan_permintaan, status], name: "ix_core_1")
