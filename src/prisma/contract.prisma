// use prisma-8

enum user_role {
  @@type("pg/text@1")
  USER  = "USER"
  ADMIN = "ADMIN"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String?
  name         String?
  passwordHash String?
  role         user_role @default(USER)
  posts        Post[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model UploadedFile {
  id           Int       @id @default(autoincrement())
  originalName String
  storageName  String    @unique
  mimeType     String
  size         Int
  uploadedById Int
  createdAt    TimestamptzString @default(now())

  @@index([uploadedById, createdAt])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
