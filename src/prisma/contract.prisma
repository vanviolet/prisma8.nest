// use prisma-8

enum UserRole {
  @@type("pg/text@1")
  USER  = "USER"
  ADMIN = "ADMIN"
}

model user {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  username      String?
  name          String?
  password_hash String?   @map("passwordHash")
  role          UserRole @default(USER)
  posts         post[]
  created_at    TimestamptzString @default(now()) @map("createdAt")
  updated_at    temporal.updatedAtString() @map("updatedAt")

  @@map("User")
}

model uploaded_file {
  id              Int       @id @default(autoincrement())
  original_name   String    @map("originalName")
  storage_name    String    @unique @map("storageName")
  mime_type       String    @map("mimeType")
  size            Int
  uploaded_by_id  Int       @map("uploadedById")
  created_at      TimestamptzString @default(now()) @map("createdAt")

  @@index([uploaded_by_id, created_at], map: "UploadedFile_uploadedById_createdAt_idx_7e8cc7c7")
  @@map("UploadedFile")
}

model post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String?
  author     user     @relation(fields: [author_id], references: [id])
  author_id  Int      @map("authorId")
  created_at TimestamptzString @default(now()) @map("createdAt")
  updated_at temporal.updatedAtString() @map("updatedAt")

  @@map("Post")
}
