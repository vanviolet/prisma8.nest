    sumber_pemenuhan               sumber_pemenuhan_permintaan @relation(fields: [id_sumber_pemenuhan_permintaan], references: [id], onDelete: Restrict)
    aset_tetap                     aset_tetap                  @relation(fields: [id_aset_tetap], references: [id], onDelete: Restrict)
    pencatat_reservasi             pengguna                    @relation(fields: [direservasi_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@check(expression: "(status = 'direservasi' AND dilepas_pada IS NULL) OR (status IN ('dibatalkan', 'dilepas') AND dilepas_pada IS NOT NULL)", name: "fixed_reservation_status_matches_release_time")
    @@index([id_aset_tetap], where: "(status = 'direservasi')", unique: true, name: "fixed_asset_reservation_active_asset")
    @@index([id_sumber_pemenuhan_permintaan, status], name: "ix_fiasre_1")
