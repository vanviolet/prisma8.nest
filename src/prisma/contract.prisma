    @@check(expression: "perubahan_jumlah <> 0", name: "stock_movement_nonzero")
    @@check(expression: "(jenis_mutasi = 'penerimaan' AND id_item_penerimaan_pengadaan IS NOT NULL) OR (jenis_mutasi <> 'penerimaan' AND id_item_penerimaan_pengadaan IS NULL)", name: "stock_receipt_movement_requires_receipt_detail")
