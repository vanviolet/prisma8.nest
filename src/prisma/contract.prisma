    @@check(expression: "jumlah_diterima >= 0 AND jumlah_ditolak >= 0 AND (jumlah_diterima + jumlah_ditolak) > 0", name: "shipment_receipt_item_quantities")
    @@check(expression: "jumlah_ditolak = 0 OR alasan_penolakan IS NOT NULL", name: "shipment_rejection_requires_reason")
