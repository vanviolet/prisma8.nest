    transfer                 transfer_antar_unit @relation(fields: [id_transfer_antar_unit], references: [id], onDelete: Restrict)
    penerima                 pengguna            @relation(fields: [diterima_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@unique([id, id_transfer_antar_unit], map: "uq_inuntrre_1")
    @@index([id_transfer_antar_unit, diterima_pada], name: "ix_inuntrre_1")
  }

  model item_penerimaan_transfer_aset_tetap {
    id                                     Uuid                                @id @default(uuid())
    id_penerimaan_transfer                 Uuid
    id_item_transfer_antar_unit_aset_tetap Uuid
    id_transfer_antar_unit                 Uuid
    diterima                               Boolean
    alasan_penolakan                       String?

    penerimaan                             penerimaan_transfer                 @relation(fields: [id_penerimaan_transfer, id_transfer_antar_unit], references: [id, id_transfer_antar_unit], onDelete: Restrict)
    item_transfer                          item_transfer_antar_unit_aset_tetap @relation(fields: [id_item_transfer_antar_unit_aset_tetap, id_transfer_antar_unit], references: [id, id_transfer_antar_unit], onDelete: Restrict)

    @@check(expression: "diterima OR alasan_penolakan IS NOT NULL", name: "transfer_asset_rejection_requires_reason")
    @@unique([id_penerimaan_transfer, id_item_transfer_antar_unit_aset_tetap], map: "uq_inuntrreit_1")
    @@unique([id_item_transfer_antar_unit_aset_tetap], map: "uq_inuntrreit_2")
    @@index([id_penerimaan_transfer], name: "ix_inuntrreit_1")
  }

  model item_penerimaan_transfer_barang_habis_pakai {
    id                                             Uuid                                        @id @default(uuid())
    id_penerimaan_transfer                         Uuid
    id_item_transfer_antar_unit_barang_habis_pakai Uuid
    id_transfer_antar_unit                         Uuid
    jumlah_diterima                                Int
    jumlah_ditolak                                 Int                                         @default(0)
    alasan_penolakan                               String?

    penerimaan                                     penerimaan_transfer                         @relation(fields: [id_penerimaan_transfer, id_transfer_antar_unit], references: [id, id_transfer_antar_unit], onDelete: Restrict)
    item_transfer                                  item_transfer_antar_unit_barang_habis_pakai @relation(fields: [id_item_transfer_antar_unit_barang_habis_pakai, id_transfer_antar_unit], references: [id, id_transfer_antar_unit], onDelete: Restrict)

    @@check(expression: "jumlah_diterima >= 0 AND jumlah_ditolak >= 0 AND (jumlah_diterima + jumlah_ditolak) > 0", name: "transfer_stock_receipt_quantities")
    @@check(expression: "jumlah_ditolak = 0 OR alasan_penolakan IS NOT NULL", name: "transfer_stock_rejection_requires_reason")
    @@unique([id_penerimaan_transfer, id_item_transfer_antar_unit_barang_habis_pakai], map: "uq_inuntrcoitre_1")
    @@index([id_item_transfer_antar_unit_barang_habis_pakai], name: "ix_inuntrcoitre_1")
  }

  model penghapusan_aset {
    id                     Uuid              @id @default(uuid())
    nomor_penghapusan      String            @unique
    id_aktor               Uuid
    jenis                  JenisPenghapusan
    alasan                 String
    dibuat_oleh_id_pegawai String
    dibuat_pada            TimestamptzString @default(now())

    aktor                  aktor             @relation(fields: [id_aktor], references: [id], onDelete: Restrict)
    pembuat                pengguna          @relation(fields: [dibuat_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@index([id_aktor, dibuat_pada], name: "ix_di_1")
  }

  model item_penghapusan_aset_tetap {
    id               Uuid             @id @default(uuid())
    id_penghapusan   Uuid
    id_aset_tetap    Uuid             @unique

    penghapusan_aset penghapusan_aset @relation(fields: [id_penghapusan], references: [id], onDelete: Restrict)
    aset_tetap       aset_tetap       @relation(fields: [id_aset_tetap], references: [id], onDelete: Restrict)

    @@index([id_penghapusan], name: "ix_difiit_1")
  }

  model item_penghapusan_barang_habis_pakai {
    id                         Uuid                    @id @default(uuid())
    id_penghapusan             Uuid
    id_stok_barang_habis_pakai Uuid
    jumlah                     Int

    penghapusan_aset           penghapusan_aset        @relation(fields: [id_penghapusan], references: [id], onDelete: Restrict)
    stok                       stok_barang_habis_pakai @relation(fields: [id_stok_barang_habis_pakai], references: [id], onDelete: Restrict)

    @@check(expression: "jumlah > 0", name: "disposal_consumable_quantity_positive")
    @@index([id_penghapusan], name: "ix_dicoit_1")
    @@index([id_stok_barang_habis_pakai], name: "ix_dicoit_2")
  }
}
