namespace public {
  model berkas {
    id                       Int               @id @default(autoincrement())
    nama_asli                String
    nama_penyimpanan         String            @unique
    tipe_mime                String
    ukuran                   Int
    diunggah_oleh_id_pegawai String
    dibuat_pada              TimestamptzString @default(now())

    pengunggah               sarpras.pengguna  @relation(fields: [diunggah_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@index([diunggah_oleh_id_pegawai, dibuat_pada], name: "ix_upfi_1")
  }
}

namespace sarpras {
  model aktor {
    id          Uuid              @id @default(uuid())
    kode        String            @unique
    jenis       JenisAktor
    nama        String
    aktif       Boolean           @default(true)
    dibuat_pada TimestamptzString @default(now())
    diubah_pada TimestamptzString @default(now())

    @@index([jenis, aktif], name: "ix_ac_1")
    @@check(expression: "char_length(kode) > 0 AND char_length(kode) <= 10 AND char_length(nama) <= 100", name: "actor_hrms_code_and_name_lengths")
  }

  model pengguna {
    id_pegawai  String            @id
    nama        String
    dibuat_pada TimestamptzString @default(now())
    diubah_pada TimestamptzString @default(now())

    @@check(expression: "char_length(id_pegawai) <= 100 AND char_length(nama) <= 100", name: "pengguna_hrms_lengths")
  }

  model kategori_aset {
    id          Uuid              @id @default(uuid())
    kode        String            @unique
    nama        String
    jenis       JenisAset
    aktif       Boolean           @default(true)
    dibuat_pada TimestamptzString @default(now())

    @@unique([nama, jenis], map: "uq_asca_1")
  }

  model variasi_aset {
    id               Uuid              @id @default(uuid())
    id_kategori_aset Uuid
    kode             String?
    nama             String
    satuan           String
    aktif            Boolean           @default(true)
    dibuat_pada      TimestamptzString @default(now())

    kategori_aset    kategori_aset     @relation(fields: [id_kategori_aset], references: [id], onDelete: Restrict)

    @@unique([id_kategori_aset, nama], map: "uq_asva_1")
    @@index([id_kategori_aset, aktif], name: "ix_asva_1")
  }

  model merek {
    id          Uuid              @id @default(uuid())
    nama        String            @unique
    aktif       Boolean           @default(true)
    dibuat_pada TimestamptzString @default(now())
  }

  model variasi_aset_merek {
    id              Uuid         @id @default(uuid())
    id_variasi_aset Uuid
    id_merek        Uuid
    aktif           Boolean      @default(true)

    variasi_aset    variasi_aset @relation(fields: [id_variasi_aset], references: [id], onDelete: Restrict)
    merek           merek        @relation(fields: [id_merek], references: [id], onDelete: Restrict)

    @@unique([id_variasi_aset, id_merek], map: "uq_asvabr_1")
    @@index([id_merek], name: "ix_asvabr_1")
  }

  model pemasok {
    id            Uuid              @id @default(uuid())
    kode          String?           @unique
    nama          String
    alamat        String?
    nomor_telepon String?
    surel         String?
    aktif         Boolean           @default(true)
    dibuat_pada   TimestamptzString @default(now())
  }

  model katalog_pemasok {
    id                    Uuid               @id @default(uuid())
    id_pemasok            Uuid
    id_variasi_aset_merek Uuid
    harga_referensi       Numeric(14, 2)?
    aktif                 Boolean            @default(true)
    dibuat_pada           TimestamptzString  @default(now())

    pemasok               pemasok            @relation(fields: [id_pemasok], references: [id], onDelete: Restrict)
    variasi_aset_merek    variasi_aset_merek @relation(fields: [id_variasi_aset_merek], references: [id], onDelete: Restrict)

    @@unique([id_pemasok, id_variasi_aset_merek], map: "uq_suca_1")
    @@unique([id, id_variasi_aset_merek], map: "uq_suca_2")
    @@index([id_variasi_aset_merek], name: "supplier_catalog_brand")
  }

  model tempat {
    id               Uuid              @id @default(uuid())
    id_tempat_induk  Uuid?
    id_aktor_pemilik Uuid?
    jenis            JenisTempat
    kode             String?
    nama             String
    deskripsi        String?
    aktif            Boolean           @default(true)
    dibuat_pada      TimestamptzString @default(now())
    diubah_pada      TimestamptzString @default(now())

    tempat_induk     tempat?           @relation("hierarki_tempat", fields: [id_tempat_induk], references: [id], onDelete: Restrict)
    aktor_pemilik    aktor?            @relation(fields: [id_aktor_pemilik], references: [id], onDelete: Restrict)

    @@unique([id_tempat_induk, kode], map: "uq_pl_1")
    @@index([id_aktor_pemilik, jenis, aktif], name: "ix_pl_1")
  }

  model gudang {
    id          Uuid              @id @default(uuid())
    id_tempat   Uuid              @unique
    kode        String            @unique
    aktif       Boolean           @default(true)
    dibuat_pada TimestamptzString @default(now())

    tempat      tempat            @relation(fields: [id_tempat], references: [id], onDelete: Restrict)
  }

  model permintaan {
    id                     Uuid               @id @default(uuid())
    nomor_permintaan       String             @unique
    id_aktor_peminta       Uuid
    id_tempat_tujuan       Uuid
    status                 StatusPermintaan   @default(draf)
    catatan                String?
    dibuat_oleh_id_pegawai String
    diajukan_pada          TimestamptzString?
    dibuat_pada            TimestamptzString  @default(now())
    diubah_pada            TimestamptzString  @default(now())

    aktor_peminta          aktor              @relation(fields: [id_aktor_peminta], references: [id], onDelete: Restrict)
    tempat_tujuan          tempat             @relation(fields: [id_tempat_tujuan], references: [id], onDelete: Restrict)
    pembuat                pengguna           @relation(fields: [dibuat_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@check(expression: "(status = 'draf' AND diajukan_pada IS NULL) OR (status <> 'draf' AND diajukan_pada IS NOT NULL)", name: "request_submission_timestamp_matches_status")
    @@index([id_aktor_peminta, status, dibuat_pada], name: "ix_re_1")
    @@index([id_tempat_tujuan], name: "ix_re_2")
  }

  model item_permintaan {
    id              Uuid         @id @default(uuid())
    id_permintaan   Uuid
    id_variasi_aset Uuid
    jumlah          Int
    catatan         String?

    permintaan      permintaan   @relation(fields: [id_permintaan], references: [id], onDelete: Restrict)
    variasi_aset    variasi_aset @relation(fields: [id_variasi_aset], references: [id], onDelete: Restrict)

    @@unique([id_permintaan, id_variasi_aset], map: "uq_reit_1")
    @@check(expression: "jumlah > 0", name: "request_item_quantity_positive")
    @@index([id_variasi_aset], name: "ix_reit_1")
  }

  model sumber_pemenuhan_permintaan {
    id                     Uuid                 @id @default(uuid())
    id_item_permintaan     Uuid
    jenis                  JenisSumberPemenuhan
    id_variasi_aset_merek  Uuid
    id_gudang              Uuid?
    id_katalog_pemasok     Uuid?
    jumlah                 Int
    status                 StatusPemenuhan      @default(diusulkan)
    alasan_penolakan       String?
    dibuat_oleh_id_pegawai String
    dibuat_pada            TimestamptzString    @default(now())
    diubah_pada            TimestamptzString    @default(now())

    item_permintaan        item_permintaan      @relation(fields: [id_item_permintaan], references: [id], onDelete: Restrict)
    variasi_aset_merek     variasi_aset_merek   @relation(fields: [id_variasi_aset_merek], references: [id], onDelete: Restrict)
    gudang                 gudang?              @relation(fields: [id_gudang], references: [id], onDelete: Restrict)
    katalog_pemasok        katalog_pemasok?     @relation(fields: [id_katalog_pemasok], references: [id], onDelete: Restrict)
    pembuat                pengguna             @relation(fields: [dibuat_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@check(expression: "(jenis = 'gudang' AND id_gudang IS NOT NULL AND id_katalog_pemasok IS NULL) OR (jenis = 'pengadaan' AND id_gudang IS NULL AND id_katalog_pemasok IS NOT NULL)", name: "request_source_reference_matches_kind")
    @@check(expression: "jumlah > 0", name: "request_source_quantity_positive")
    @@index([id_item_permintaan, status], name: "ix_refuso_1")
    @@index([id_variasi_aset_merek], name: "rfs_asset_brand")
  }

  model riwayat_status_sumber_pemenuhan {
    id                             Uuid                        @id @default(uuid())
    id_sumber_pemenuhan_permintaan Uuid
    status_sebelumnya              StatusPemenuhan?
    status_baru                    StatusPemenuhan
    dilakukan_oleh_id_pegawai      String
    id_aktor_konteks               Uuid?
    catatan                        String?
    dibuat_pada                    TimestamptzString           @default(now())

    sumber_pemenuhan               sumber_pemenuhan_permintaan @relation(fields: [id_sumber_pemenuhan_permintaan], references: [id], onDelete: Restrict)
    pelaku                         pengguna                    @relation(fields: [dilakukan_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)
    aktor_konteks                  aktor?                      @relation(fields: [id_aktor_konteks], references: [id], onDelete: Restrict)

    @@index([id_sumber_pemenuhan_permintaan, dibuat_pada], name: "ix_refuhi_1")
    @@index([id_aktor_konteks, dibuat_pada], name: "ix_refuhi_2")
  }

  model riwayat_status_permintaan {
    id                        Uuid              @id @default(uuid())
    id_permintaan             Uuid
    status_sebelumnya         StatusPermintaan?
    status_baru               StatusPermintaan
    dilakukan_oleh_id_pegawai String
    id_aktor_konteks          Uuid?
    catatan                   String?
    dibuat_pada               TimestamptzString @default(now())

    permintaan                permintaan        @relation(fields: [id_permintaan], references: [id], onDelete: Restrict)
    pelaku                    pengguna          @relation(fields: [dilakukan_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)
    aktor_konteks             aktor?            @relation(fields: [id_aktor_konteks], references: [id], onDelete: Restrict)

    @@index([id_permintaan, dibuat_pada], name: "ix_resthi_1")
  }

  model pengadaan {
    id                     Uuid              @id @default(uuid())
    nomor_pengadaan        String            @unique
    jenis                  JenisPengadaan
    alur_pengadaan         AlurPengadaan
    id_aktor               Uuid
    status                 StatusPengadaan   @default(draf)
    catatan                String?
    dibuat_oleh_id_pegawai String
    dibuat_pada            TimestamptzString @default(now())
    diubah_pada            TimestamptzString @default(now())

    aktor                  aktor             @relation(fields: [id_aktor], references: [id], onDelete: Restrict)
    pembuat                pengguna          @relation(fields: [dibuat_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@index([id_aktor, status, dibuat_pada], name: "ix_pr_1")
  }

  model item_pengadaan {
    id                    Uuid                @id @default(uuid())
    id_pengadaan          Uuid
    id_katalog_pemasok    Uuid
    id_variasi_aset_merek Uuid
    jumlah                Int
    harga_satuan          Numeric(14, 2)
    sumber_dana           SumberDana
    status                StatusItemPengadaan @default(draf)
    perlu_persetujuan     Boolean             @default(true)
    dibuat_pada           TimestamptzString   @default(now())
    diubah_pada           TimestamptzString   @default(now())

    pengadaan             pengadaan           @relation(fields: [id_pengadaan], references: [id], onDelete: Restrict)
    katalog_pemasok       katalog_pemasok     @relation(fields: [id_katalog_pemasok, id_variasi_aset_merek], references: [id, id_variasi_aset_merek], onDelete: Restrict)

    @@check(expression: "jumlah > 0", name: "procurement_item_quantity_positive")
    @@check(expression: "harga_satuan >= 0", name: "procurement_item_price_nonnegative")
    @@unique([id, id_pengadaan], map: "uq_prit_3")
    @@unique([id, id_pengadaan, id_variasi_aset_merek], map: "uq_prit_4")
    @@index([id_pengadaan, status], name: "ix_prit_1")
    @@index([id_katalog_pemasok], name: "ix_prit_2")
  }

  model alokasi_item_pengadaan_permintaan {
    id                             Uuid                        @id @default(uuid())
    id_item_pengadaan              Uuid
    id_sumber_pemenuhan_permintaan Uuid
    jumlah                         Int
    dibuat_pada                    TimestamptzString           @default(now())

    item_pengadaan                 item_pengadaan              @relation(fields: [id_item_pengadaan], references: [id], onDelete: Restrict)
    sumber_pemenuhan               sumber_pemenuhan_permintaan @relation(fields: [id_sumber_pemenuhan_permintaan], references: [id], onDelete: Restrict)

    @@unique([id_item_pengadaan, id_sumber_pemenuhan_permintaan], map: "uq_pritreal_1")
    @@check(expression: "jumlah > 0", name: "procurement_allocation_quantity_positive")
    @@index([id_sumber_pemenuhan_permintaan], name: "ix_pritreal_1")
  }

  model riwayat_status_pengadaan {
    id                        Uuid              @id @default(uuid())
    id_pengadaan              Uuid
    status_sebelumnya         StatusPengadaan?
    status_baru               StatusPengadaan
    dilakukan_oleh_id_pegawai String
    catatan                   String?
    dibuat_pada               TimestamptzString @default(now())

    pengadaan                 pengadaan         @relation(fields: [id_pengadaan], references: [id], onDelete: Restrict)
    pelaku                    pengguna          @relation(fields: [dilakukan_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@index([id_pengadaan, dibuat_pada], name: "ix_prsthi_1")
  }

  model riwayat_status_item_pengadaan {
    id                        Uuid                 @id @default(uuid())
    id_item_pengadaan         Uuid
    status_sebelumnya         StatusItemPengadaan?
    status_baru               StatusItemPengadaan
    dilakukan_oleh_id_pegawai String
    catatan                   String?
    dibuat_pada               TimestamptzString    @default(now())

    item_pengadaan            item_pengadaan       @relation(fields: [id_item_pengadaan], references: [id], onDelete: Restrict)
    pelaku                    pengguna             @relation(fields: [dilakukan_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@index([id_item_pengadaan, dibuat_pada], name: "ix_prith_1")
  }

  model penerimaan_pengadaan {
    id                       Uuid              @id @default(uuid())
    id_pengadaan             Uuid
    id_gudang                Uuid
    diterima_oleh_id_pegawai String
    diterima_pada            TimestamptzString @default(now())
    catatan                  String?

    pengadaan                pengadaan         @relation(fields: [id_pengadaan], references: [id], onDelete: Restrict)
    gudang                   gudang            @relation(fields: [id_gudang], references: [id], onDelete: Restrict)
    penerima                 pengguna          @relation(fields: [diterima_oleh_id_pegawai], references: [id_pegawai], onDelete: Restrict)

    @@unique([id, id_pengadaan], map: "uq_prre_2")
    @@index([id_pengadaan, diterima_pada], name: "ix_prre_1")
  }

  model item_penerimaan_pengadaan {
    id                      Uuid                 @id @default(uuid())
    id_penerimaan_pengadaan Uuid
    id_item_pengadaan       Uuid
    id_pengadaan            Uuid
    id_variasi_aset_merek   Uuid
    jumlah_diterima         Int
    alasan_perbedaan        String?
    dibuat_pada             TimestamptzString    @default(now())

    penerimaan_pengadaan    penerimaan_pengadaan @relation(fields: [id_penerimaan_pengadaan, id_pengadaan], references: [id, id_pengadaan], onDelete: Restrict)
    item_pengadaan          item_pengadaan       @relation(fields: [id_item_pengadaan, id_pengadaan, id_variasi_aset_merek], references: [id, id_pengadaan, id_variasi_aset_merek], onDelete: Restrict)

    @@unique([id_penerimaan_pengadaan, id_item_pengadaan], map: "uq_prreit_1")
    @@unique([id, id_variasi_aset_merek], map: "uq_prreit_2")
    @@check(expression: "jumlah_diterima > 0", name: "receipt_item_quantity_positive")
    @@index([id_item_pengadaan], name: "ix_prreit_1")
  }

  model tagihan {
    id                     Uuid              @id @default(uuid())
    id_pengadaan           Uuid
    nomor_tagihan          String
    tanggal_tagihan        DateString?
    nominal                Numeric(14, 2)
    status                 StatusTagihan     @default(diajukan)
