# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Replace this placeholder with a random value of at least 32 characters.
JWT_SECRET="replace-this-with-a-random-secret-string-at-least-32-chars"
JWT_EXPIRES_IN_SECONDS=3600

NODE_ENV=development
PORT=3000
CORS_ORIGIN="*"
